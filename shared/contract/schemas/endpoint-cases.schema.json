{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fzrsahi/Morrow/schemas/endpoint-cases.schema.json",
  "title": "Endpoint resolution cases",
  "description": "Case table for the endpoint rule in shared/contract/endpoint-contract.md: environment, OS and files on disk in, endpoint string out.",
  "type": "object",
  "required": ["version", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "contract": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "os", "env", "existing", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^(macos|linux|windows)-[a-z0-9-]+$" },
        "os": { "enum": ["macos", "linux", "windows"] },
        "env": {
          "description": "The process environment. A key that is absent is unset; a key with an empty string is set to empty.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "uid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "sid": { "type": "string", "minLength": 1 },
        "existing": {
          "description": "Paths that exist on disk. Every other path does not.",
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        },
        "expected": { "type": "string" },
        "proposed": {
          "description": "What the case resolves to under the rule proposed for an open question, where that differs from today's expected.",
          "type": "string"
        },
        "open_question": { "type": "string", "pattern": "^OQ-[0-9]+$" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "os": { "const": "windows" } } },
          "then": { "required": ["sid"], "not": { "required": ["uid"] } },
          "else": { "required": ["uid"], "not": { "required": ["sid"] } }
        },
        {
          "if": { "required": ["proposed"] },
          "then": { "required": ["open_question"] }
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": ["path", "kind"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["socket", "file", "directory", "symlink"] },
        "target": {
          "description": "Where a symlink points. It counts as existing only when its target does.",
          "type": "string",
          "minLength": 1
        }
      },
      "if": { "properties": { "kind": { "const": "symlink" } } },
      "then": { "required": ["target"] },
      "else": { "not": { "required": ["target"] } }
    }
  }
}
