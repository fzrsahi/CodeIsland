{
  "version": 1,
  "contract": "shared/contract/endpoint-contract.md",
  "cases": [
    {
      "name": "macos-default-nothing-exists",
      "os": "macos",
      "env": {},
      "uid": 501,
      "existing": [],
      "expected": "/tmp/morrow-501.sock"
    },
    {
      "name": "macos-morrow-socket-exists",
      "os": "macos",
      "env": {},
      "uid": 501,
      "existing": [{ "path": "/tmp/morrow-501.sock", "kind": "socket" }],
      "expected": "/tmp/morrow-501.sock"
    },
    {
      "name": "macos-legacy-only-present",
      "os": "macos",
      "env": {},
      "uid": 501,
      "existing": [{ "path": "/tmp/codeisland-501.sock", "kind": "socket" }],
      "expected": "/tmp/codeisland-501.sock"
    },
    {
      "name": "macos-both-present-morrow-wins",
      "os": "macos",
      "env": {},
      "uid": 501,
      "existing": [
        { "path": "/tmp/morrow-501.sock", "kind": "socket" },
        { "path": "/tmp/codeisland-501.sock", "kind": "socket" }
      ],
      "expected": "/tmp/morrow-501.sock"
    },
    {
      "name": "macos-legacy-regular-file-still-selected",
      "os": "macos",
      "env": {},
      "uid": 501,
      "existing": [{ "path": "/tmp/codeisland-501.sock", "kind": "file" }],
      "expected": "/tmp/codeisland-501.sock",
      "open_question": "OQ-2",
      "note": "Selection checks existence of any kind; the peer check (Holder) then refuses the file and the edge sends nothing."
    },
    {
      "name": "macos-legacy-symlink-to-existing-target-counts-as-present",
      "os": "macos",
      "env": {},
      "uid": 501,
      "existing": [
        { "path": "/tmp/codeisland-501.sock", "kind": "symlink", "target": "/tmp/elsewhere.sock" },
        { "path": "/tmp/elsewhere.sock", "kind": "socket" }
      ],
      "expected": "/tmp/codeisland-501.sock",
      "note": "Existence follows symlinks (stat, not lstat). The peer check later refuses the symlink."
    },
    {
      "name": "macos-legacy-dangling-symlink-counts-as-absent",
      "os": "macos",
      "env": {},
      "uid": 501,
      "existing": [
        { "path": "/tmp/codeisland-501.sock", "kind": "symlink", "target": "/tmp/gone.sock" }
      ],
      "expected": "/tmp/morrow-501.sock"
    },
    {
      "name": "macos-legacy-of-another-uid-is-ignored",
      "os": "macos",
      "env": {},
      "uid": 502,
      "existing": [{ "path": "/tmp/codeisland-501.sock", "kind": "socket" }],
      "expected": "/tmp/morrow-502.sock"
    },
    {
      "name": "macos-root-uid",
      "os": "macos",
      "env": {},
      "uid": 0,
      "existing": [],
      "expected": "/tmp/morrow-0.sock"
    },
    {
      "name": "macos-morrow-override",
      "os": "macos",
      "env": { "MORROW_SOCKET_PATH": "/Users/me/island.sock" },
      "uid": 501,
      "existing": [],
      "expected": "/Users/me/island.sock"
    },
    {
      "name": "macos-codeisland-override",
      "os": "macos",
      "env": { "CODEISLAND_SOCKET_PATH": "/Users/me/legacy.sock" },
      "uid": 501,
      "existing": [],
      "expected": "/Users/me/legacy.sock"
    },
    {
      "name": "macos-both-overrides-morrow-wins",
      "os": "macos",
      "env": {
        "MORROW_SOCKET_PATH": "/Users/me/island.sock",
        "CODEISLAND_SOCKET_PATH": "/Users/me/legacy.sock"
      },
      "uid": 501,
      "existing": [],
      "expected": "/Users/me/island.sock"
    },
    {
      "name": "macos-override-ignores-files-on-disk",
      "os": "macos",
      "env": { "MORROW_SOCKET_PATH": "/Users/me/island.sock" },
      "uid": 501,
      "existing": [{ "path": "/tmp/codeisland-501.sock", "kind": "socket" }],
      "expected": "/Users/me/island.sock"
    },
    {
      "name": "macos-relative-override-used-as-is",
      "os": "macos",
      "env": { "MORROW_SOCKET_PATH": "island.sock" },
      "uid": 501,
      "existing": [],
      "expected": "island.sock"
    },
    {
      "name": "macos-xdg-runtime-dir-ignored",
      "os": "macos",
      "env": { "XDG_RUNTIME_DIR": "/run/user/501" },
      "uid": 501,
      "existing": [],
      "expected": "/tmp/morrow-501.sock"
    },
    {
      "name": "macos-empty-morrow-override-is-used",
      "os": "macos",
      "env": { "MORROW_SOCKET_PATH": "" },
      "uid": 501,
      "existing": [],
      "expected": "",
      "open_question": "OQ-1",
      "proposed": "/tmp/morrow-501.sock"
    },
    {
      "name": "macos-empty-morrow-override-masks-codeisland",
      "os": "macos",
      "env": { "MORROW_SOCKET_PATH": "", "CODEISLAND_SOCKET_PATH": "/Users/me/legacy.sock" },
      "uid": 501,
      "existing": [],
      "expected": "",
      "open_question": "OQ-1",
      "proposed": "/Users/me/legacy.sock"
    },
    {
      "name": "macos-empty-codeisland-override-is-used",
      "os": "macos",
      "env": { "CODEISLAND_SOCKET_PATH": "" },
      "uid": 501,
      "existing": [{ "path": "/tmp/codeisland-501.sock", "kind": "socket" }],
      "expected": "",
      "open_question": "OQ-1",
      "proposed": "/tmp/codeisland-501.sock"
    },
    {
      "name": "linux-no-env-no-xdg",
      "os": "linux",
      "env": {},
      "uid": 1000,
      "existing": [],
      "expected": "/tmp/morrow-1000.sock"
    },
    {
      "name": "linux-xdg-set",
      "os": "linux",
      "env": { "XDG_RUNTIME_DIR": "/run/user/1000" },
      "uid": 1000,
      "existing": [],
      "expected": "/run/user/1000/morrow/island.sock"
    },
    {
      "name": "linux-xdg-trailing-slashes-stripped",
      "os": "linux",
      "env": { "XDG_RUNTIME_DIR": "/run/user/1000//" },
      "uid": 1000,
      "existing": [],
      "expected": "/run/user/1000/morrow/island.sock"
    },
    {
      "name": "linux-xdg-relative-ignored",
      "os": "linux",
      "env": { "XDG_RUNTIME_DIR": "run/user/1000" },
      "uid": 1000,
      "existing": [],
      "expected": "/tmp/morrow-1000.sock"
    },
    {
      "name": "linux-xdg-empty-ignored",
      "os": "linux",
      "env": { "XDG_RUNTIME_DIR": "" },
      "uid": 1000,
      "existing": [],
      "expected": "/tmp/morrow-1000.sock"
    },
    {
      "name": "linux-legacy-socket-never-selected",
      "os": "linux",
      "env": {},
      "uid": 1000,
      "existing": [{ "path": "/tmp/codeisland-1000.sock", "kind": "socket" }],
      "expected": "/tmp/morrow-1000.sock"
    },
    {
      "name": "linux-morrow-override",
      "os": "linux",
      "env": { "MORROW_SOCKET_PATH": "/home/me/island.sock", "XDG_RUNTIME_DIR": "/run/user/1000" },
      "uid": 1000,
      "existing": [],
      "expected": "/home/me/island.sock"
    },
    {
      "name": "linux-codeisland-override",
      "os": "linux",
      "env": { "CODEISLAND_SOCKET_PATH": "/home/me/legacy.sock" },
      "uid": 1000,
      "existing": [],
      "expected": "/home/me/legacy.sock"
    },
    {
      "name": "linux-both-overrides-morrow-wins",
      "os": "linux",
      "env": {
        "MORROW_SOCKET_PATH": "/home/me/island.sock",
        "CODEISLAND_SOCKET_PATH": "/home/me/legacy.sock"
      },
      "uid": 1000,
      "existing": [],
      "expected": "/home/me/island.sock"
    },
    {
      "name": "linux-empty-morrow-override-counts-as-unset",
      "os": "linux",
      "env": { "MORROW_SOCKET_PATH": "", "XDG_RUNTIME_DIR": "/run/user/1000" },
      "uid": 1000,
      "existing": [],
      "expected": "/run/user/1000/morrow/island.sock",
      "open_question": "OQ-1"
    },
    {
      "name": "linux-empty-morrow-override-falls-through-to-codeisland",
      "os": "linux",
      "env": { "MORROW_SOCKET_PATH": "", "CODEISLAND_SOCKET_PATH": "/home/me/legacy.sock" },
      "uid": 1000,
      "existing": [],
      "expected": "/home/me/legacy.sock",
      "open_question": "OQ-1"
    },
    {
      "name": "linux-xdg-root",
      "os": "linux",
      "env": { "XDG_RUNTIME_DIR": "/" },
      "uid": 1000,
      "existing": [],
      "expected": "/morrow/island.sock"
    },
    {
      "name": "windows-standard-sid",
      "os": "windows",
      "env": {},
      "sid": "S-1-5-21-1004336348-1177238915-682003330-1001",
      "existing": [],
      "expected": "\\\\.\\pipe\\morrow-S-1-5-21-1004336348-1177238915-682003330-1001"
    },
    {
      "name": "windows-well-known-sid-case-preserved",
      "os": "windows",
      "env": {},
      "sid": "s-1-5-18",
      "existing": [],
      "expected": "\\\\.\\pipe\\morrow-s-1-5-18"
    },
    {
      "name": "windows-sid-non-alphanumerics-become-dashes",
      "os": "windows",
      "env": {},
      "sid": "S-1-5_21.x y\\z",
      "existing": [],
      "expected": "\\\\.\\pipe\\morrow-S-1-5-21-x-y-z"
    },
    {
      "name": "windows-sid-non-ascii-letter-becomes-dash",
      "os": "windows",
      "env": {},
      "sid": "S-1-5-\u00e9",
      "existing": [],
      "expected": "\\\\.\\pipe\\morrow-S-1-5--",
      "note": "ASCII-only rule. C# char.IsLetterOrDigit would keep the letter; real SIDs are ASCII, so no real name changes."
    },
    {
      "name": "windows-morrow-override",
      "os": "windows",
      "env": { "MORROW_SOCKET_PATH": "\\\\.\\pipe\\my-island" },
      "sid": "S-1-5-21-1-2-3-1001",
      "existing": [],
      "expected": "\\\\.\\pipe\\my-island"
    },
    {
      "name": "windows-codeisland-override",
      "os": "windows",
      "env": { "CODEISLAND_SOCKET_PATH": "\\\\.\\pipe\\legacy-island" },
      "sid": "S-1-5-21-1-2-3-1001",
      "existing": [],
      "expected": "\\\\.\\pipe\\legacy-island"
    },
    {
      "name": "windows-both-overrides-morrow-wins",
      "os": "windows",
      "env": {
        "MORROW_SOCKET_PATH": "\\\\.\\pipe\\my-island",
        "CODEISLAND_SOCKET_PATH": "\\\\.\\pipe\\legacy-island"
      },
      "sid": "S-1-5-21-1-2-3-1001",
      "existing": [],
      "expected": "\\\\.\\pipe\\my-island"
    },
    {
      "name": "windows-empty-morrow-override-counts-as-unset",
      "os": "windows",
      "env": { "MORROW_SOCKET_PATH": "" },
      "sid": "S-1-5-21-1-2-3-1001",
      "existing": [],
      "expected": "\\\\.\\pipe\\morrow-S-1-5-21-1-2-3-1001",
      "open_question": "OQ-1"
    }
  ]
}
