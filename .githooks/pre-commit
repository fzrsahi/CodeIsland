#!/bin/sh
# Morrow Local Pre-Commit Verification Hook
# Fast (< 0.5s) guard for staged files: syntax parsing, conflict markers, and oversized assets.

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# 1. Check for unresolved merge conflict markers in staged files
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        if grep -En "^(<<<<<<<|=======|>>>>>>>)" "$file" >/dev/null 2>&1; then
            echo "❌ [Pre-Commit Error] Unresolved merge conflict marker detected in '$file'!"
            echo "👉 Please resolve all conflict markers before committing."
            exit 1
        fi
    fi
done

# 2. Check for accidentally staged oversized files (> 5MB)
MAX_BYTES=5242880
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        FILE_SIZE=$(wc -c < "$file" 2>/dev/null || echo 0)
        if [ "$FILE_SIZE" -gt "$MAX_BYTES" ]; then
            echo "❌ [Pre-Commit Error] File '$file' exceeds 5MB ($FILE_SIZE bytes)!"
            echo "👉 Avoid committing large binary assets directly into git history."
            exit 1
        fi
    fi
done

# 3. Fast syntax verification on staged Swift files
SWIFT_FILES=$(echo "$STAGED_FILES" | grep '\.swift$' || true)
if [ -n "$SWIFT_FILES" ]; then
    if command -v swiftc >/dev/null 2>&1; then
        for sfile in $SWIFT_FILES; do
            if [ -f "$sfile" ]; then
                if ! swiftc -parse "$sfile"; then
                    echo ""
                    echo "❌ [Pre-Commit Error] Swift syntax error detected in '$sfile'!"
                    echo "👉 Fix syntax errors in staged files before committing."
                    exit 1
                fi
            fi
        done
    fi
fi

exit 0
