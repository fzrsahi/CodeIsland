<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Morrow.Core\Morrow.Core.csproj" />
    <ProjectReference Include="..\Morrow.Ipc\Morrow.Ipc.csproj" />
    <ProjectReference Include="..\Morrow.Hooks\Morrow.Hooks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\source\*.gif" Link="source\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\source\morrow.png" Link="source\morrow.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\source\morrow.ico" Link="source\morrow.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\source\morrow.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
